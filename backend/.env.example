SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_...-or-service-role-jwt
APP_ENV=dev
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# AI (optional — insights/admin work without; explain/quiz need key)
AI_PROVIDER=openai-compatible
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
# SaaS billing (Razorpay) — empty = manual activation mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# WhatsApp (approved provider) — empty = in-app only
WHATSAPP_PROVIDER=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
